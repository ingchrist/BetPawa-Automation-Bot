# Copy to .env and adjust if needed. Every value below has a working default
# baked into shared/config.py, so .env only needs to override what you change.

# --- 1xbet public JSON API (reverse-engineered from the site's own frontend
# calls — see README.md "How data is sourced" for how these were found and
# why the browser/CDP route was abandoned) ---
ONEXBET_API_BASE=https://1xbet.cm/service-api
ONEXBET_SPORT_ID=85
# Substring match (case-insensitive) against a league's name. This is
# intentionally a name filter, not a hardcoded league id: the site rotates
# "FC 25. 3x3. ..." to "FC 26. 3x3. ..." etc. every so often, and this way
# the bot keeps tracking whatever the current 3x3 league is called without
# a code change.
ONEXBET_LEAGUE_NAME_FILTER=3x3

# How often each service polls / re-renders. Matches in this league run
# ~5 minutes end to end (two ~2.5 minute halves), so 5s is granular enough
# to catch half-time without hammering the API.
COLLECTOR_BULK_POLL_SECONDS=5
COLLECTOR_DETAIL_POLL_SECONDS=5
HTTP_TIMEOUT_SECONDS=10

# --- Event bus (Redis pub/sub) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Persistence ---
# Append-only JSONL log of finished matches, kept independent of the site
# (which drops results from its own UI once they scroll off "live"). This
# one is machine-readable, used by the display service to backfill recent
# results on its own startup.
RESULTS_LOG_PATH=data/results.jsonl
# Plain-text, human-readable twin of the above — the same RESULT block the
# terminal prints, one per finished round, meant to be opened directly
# (e.g. for spotting patterns across rounds). Note the singular "RESULT" —
# easy to mistype as RESULTS_LOG_PATH above; they are two different files.
RESULT_LOG_PATH=data/result.log

LOG_DIR=logs

# --- Betting: Pattern 1 — "1st Half Over 6.5" streak (services/bettor) ---
# Fires after PATTERN_STREAK_LENGTH consecutive finished rounds each have a
# 1st-half combined goal total <= PATTERN_LOW_THRESHOLD; bets on the next
# round's Total. 1st half market, Over PATTERN_BET_LINE. Real money, live
# from the first run — see README.md "Betting patterns" before changing
# these.
BET_STAKE_AMOUNT=90
PATTERN_STREAK_LENGTH=2
PATTERN_LOW_THRESHOLD=6
PATTERN_BET_LINE=6.5
# Chrome DevTools Protocol endpoint for the already-running, already-logged-in
# browser the bettor reads fresh auth (a cookie + a localStorage token) from
# before every bet — it places bets via a direct API call, not UI clicks, so
# this is a read-only touch, never a browser this bot launches or drives.
CDP_URL=http://127.0.0.1:9222
# Plain-text audit trail of every pattern fire / bet placed / failed /
# settled, written by the display service, tracked in git like RESULT_LOG_PATH.
BETS_LOG_PATH=data/bets.log

# --- Betting: Pattern 2 — "2nd Half Under 7.5" streak (services/bettor) ---
# Mirrors Pattern 1 in the opposite direction: fires after
# PATTERN2_STREAK_LENGTH consecutive finished rounds each have a 2nd-half
# combined goal total >= PATTERN2_HIGH_THRESHOLD; bets on the next round's
# Total. 2nd half market, Under PATTERN2_BET_LINE. Real money, live from
# the first run -- see README.md "Betting patterns" before changing these.
# Runs as a second, independent pattern in the same services/bettor
# process as Pattern 1 -- no separate service to start.
PATTERN2_HIGH_THRESHOLD=8
PATTERN2_STREAK_LENGTH=3
PATTERN2_BET_LINE=7.5
PATTERN2_BET_STAKE_AMOUNT=90
# Kill switch for Pattern 2 only -- Pattern 1 is unaffected either way.
# Defaults to true (unchanged behavior) if unset. Set to false to pause
# Pattern 2: it keeps tracking the streak and publishes normal
# PatternProgress on non-firing rounds (so nothing needs to "warm back
# up"), but on a firing round it only logs a warning ("PATTERN 2 ARMED
# ... suppressing bet placement") instead of publishing PatternArmed or
# arming a target/calling BetExecutor, so it cannot place a bet while off.
PATTERN2_ENABLED=true

# --- Betting: Pattern 3 — "1st Half Winner 2X" streak (services/bettor) ---
# Fires after PATTERN3_STREAK_LENGTH consecutive finished rounds each have
# a 1st-half Double Chance result of exactly "2X" (away win or draw);
# bets on the next round's Double Chance. 1st half market, selection 1X.
# Real money, live from the first run if PATTERN3_ENABLED is true -- see
# README.md "Betting patterns" before changing these. Runs as a third,
# independent pattern in the same services/bettor process as Pattern 1/2
# -- no separate service to start.
PATTERN3_STREAK_LENGTH=2
PATTERN3_BET_STAKE_AMOUNT=90
# Kill switch for Pattern 3 only -- Pattern 1/2 are unaffected either way.
# Defaults to true (Pattern 3 goes live immediately) if unset. Set to
# false to pause Pattern 3: it keeps tracking the streak and publishes
# normal PatternProgress on non-firing rounds, but on a firing round it
# only logs a warning ("PATTERN 3 ARMED ... suppressing bet placement")
# instead of publishing PatternArmed or arming a target/calling
# BetExecutor, so it cannot place a bet while off.
PATTERN3_ENABLED=true

# --- Betting: Pattern 4 — "Main Game Under 16.5" pair streak (services/bettor) ---
# Watches every finished round's 1st-half total and 2nd-half total (2
# values per round). Groups rounds into non-overlapping pairs of 2 (4
# values). Fires when >= 3 of those 4 values are >= 9; bets on the next
# round's Total. Main game market, Under PATTERN4_BET_LINE. Same
# fire -> skip-one-round -> restart life cycle as Patterns 1-3, applied
# to a pair-based counter instead of a single-scalar streak -- see
# services/bettor/pattern.py's RoundPairStreakTracker. Real money, live
# from the first run if PATTERN4_ENABLED is true -- see README.md
# "Betting patterns" before changing these. Runs as a fourth,
# independent pattern in the same services/bettor process as Pattern
# 1/2/3 -- no separate service to start. Unlike Patterns 1-3, this
# pattern's BetExecutor call waits for the live odds to reach 1.5 before
# submitting (hardcoded, not env-configurable) -- see the design spec
# for why, and note it does NOT participate in the other patterns'
# mutual-exclusion check (different market, no shared risk).
PATTERN4_BET_LINE=16.5
PATTERN4_BET_STAKE_AMOUNT=90
# Kill switch for Pattern 4 only -- Pattern 1/2/3 are unaffected either
# way. Defaults to true (Pattern 4 goes live immediately) if unset. Set
# to false to pause Pattern 4: it keeps tracking the pair and publishes
# normal PatternProgress on non-firing rounds, but on a firing round it
# only logs a warning ("PATTERN 4 ARMED ... suppressing bet placement")
# instead of publishing PatternArmed or arming a target/calling
# BetExecutor, so it cannot place a bet while off.
PATTERN4_ENABLED=true

# --- Betting: Pattern 5 -- "Live Half-Pair Confirm" Main Game Under
# (services/bettor) ---
# Watches a single round's 1st-half total AND 2nd-half total -- BOTH must
# be >= 9 to qualify (an AND across one round's two halves, not Pattern
# 4's pair-of-rounds count). The 1st half is only knowable at
# MatchHalfTime, so a round below 9 there is dead immediately -- no need
# to watch its 2nd half. If the 1st half is already >= 9, the 2nd half's
# live, still-climbing goal count is watched via MatchScoreChanged and
# the round fires the instant that count also reaches 9 -- mid-round, not
# waiting for MatchFinished. Same fire -> skip-one-round -> restart life
# cycle as Patterns 1-4 -- see services/bettor/pattern.py's
# SecondHalfLiveConfirmTracker. Bets on the next round's Total. Main game
# market, Under PATTERN5_BET_LINE. Real money, live from the first run if
# PATTERN5_ENABLED is true -- see README.md "Betting patterns" before
# changing these. Runs as a fifth, independent pattern in the same
# services/bettor process as Pattern 1/2/3/4 -- no separate service to
# start. Like Pattern 4, this waits for the live odds to reach 1.5 before
# submitting (hardcoded, not env-configurable), and does NOT participate
# in Patterns 1-3's mutual-exclusion check, nor Pattern 4's -- different
# market (Total. Main game, same market Pattern 4 also bets), no shared
# risk gate between the two.
PATTERN5_BET_LINE=16.5
PATTERN5_BET_STAKE_AMOUNT=90
# Kill switch for Pattern 5 only -- Patterns 1-4 are unaffected either
# way. Defaults to true (Pattern 5 goes live immediately) if unset. Set
# to false to pause Pattern 5: it keeps tracking each round and publishes
# normal PatternProgress on non-firing rounds, but on a firing round it
# only logs a warning ("PATTERN 5 ARMED ... suppressing bet placement")
# instead of publishing PatternArmed or arming a target/calling
# BetExecutor, so it cannot place a bet while off.
PATTERN5_ENABLED=true

# --- Betting: automatic session recovery (services/bettor) ---
# Detects when the browser's 1xbet.cm session has been logged out and
# logs back in automatically, so you only ever need to log in by hand
# when automated recovery itself can't succeed (wrong credentials, an
# unexpected captcha/2FA step, or no browser tab open). See README.md
# "Automatic session recovery" before relying on this.
ONEXBET_PHONE_NUMBER=
ONEXBET_PASSWORD=
# Kill switch, mirroring PATTERN*_ENABLED's convention. Set false to
# disable auto-recovery entirely and go back to fully manual login.
AUTH_WATCHDOG_ENABLED=true
# How often the watchdog checks whether the session is still alive.
AUTH_WATCHDOG_CHECK_INTERVAL_SECONDS=60
# Minimum gap between consecutive login attempts, so a persistently
# broken login (wrong password, a UI change, an unexpected captcha)
# doesn't retry every interval forever.
AUTH_WATCHDOG_LOGIN_COOLDOWN_SECONDS=300
# How long a single login attempt polls for the access_token cookie to
# appear after submitting the form before giving up.
AUTH_WATCHDOG_LOGIN_TIMEOUT_SECONDS=15
