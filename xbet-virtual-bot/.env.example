# Copy to .env and adjust if needed. Every value below has a working default
# baked into shared/config.py, so .env only needs to override what you change.

# --- 1xbet public JSON API (reverse-engineered from the site's own frontend
# calls — see README.md "How data is sourced" for how these were found and
# why the browser/CDP route was abandoned) ---
ONEXBET_API_BASE=https://1xbet.cm/service-api
ONEXBET_SPORT_ID=85
# Substring match (case-insensitive) against a league's name. This is
# intentionally a name filter, not a hardcoded league id: the site rotates
# "FC 25. 3x3. ..." to "FC 26. 3x3. ..." etc. every so often, and this way
# the bot keeps tracking whatever the current 3x3 league is called without
# a code change.
ONEXBET_LEAGUE_NAME_FILTER=3x3

# How often each service polls / re-renders. Matches in this league run
# ~5 minutes end to end (two ~2.5 minute halves), so 5s is granular enough
# to catch half-time without hammering the API.
COLLECTOR_BULK_POLL_SECONDS=5
COLLECTOR_DETAIL_POLL_SECONDS=5
HTTP_TIMEOUT_SECONDS=10

# --- Event bus (Redis pub/sub) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Persistence ---
# Append-only JSONL log of finished matches, kept independent of the site
# (which drops results from its own UI once they scroll off "live"). This
# one is machine-readable, used by the display service to backfill recent
# results on its own startup.
RESULTS_LOG_PATH=data/results.jsonl
# Plain-text, human-readable twin of the above — the same RESULT block the
# terminal prints, one per finished round, meant to be opened directly
# (e.g. for spotting patterns across rounds). Note the singular "RESULT" —
# easy to mistype as RESULTS_LOG_PATH above; they are two different files.
RESULT_LOG_PATH=data/result.log

LOG_DIR=logs

# --- Betting: Pattern 1 — "1st Half Over 6.5" streak (services/bettor) ---
# Fires after PATTERN_STREAK_LENGTH consecutive finished rounds each have a
# 1st-half combined goal total <= PATTERN_LOW_THRESHOLD; bets on the next
# round's Total. 1st half market, Over PATTERN_BET_LINE. Real money, live
# from the first run — see README.md "Betting patterns" before changing
# these.
BET_STAKE_AMOUNT=90
PATTERN_STREAK_LENGTH=2
PATTERN_LOW_THRESHOLD=6
PATTERN_BET_LINE=6.5
# Chrome DevTools Protocol endpoint for the already-running, already-logged-in
# browser the bettor reads fresh auth (a cookie + a localStorage token) from
# before every bet — it places bets via a direct API call, not UI clicks, so
# this is a read-only touch, never a browser this bot launches or drives.
CDP_URL=http://127.0.0.1:9222
# Plain-text audit trail of every pattern fire / bet placed / failed /
# settled, written by the display service, tracked in git like RESULT_LOG_PATH.
BETS_LOG_PATH=data/bets.log

# --- Betting: Pattern 2 — "2nd Half Under 7.5" streak (services/bettor) ---
# Mirrors Pattern 1 in the opposite direction: fires after
# PATTERN2_STREAK_LENGTH consecutive finished rounds each have a 2nd-half
# combined goal total >= PATTERN2_HIGH_THRESHOLD; bets on the next round's
# Total. 2nd half market, Under PATTERN2_BET_LINE. Real money, live from
# the first run -- see README.md "Betting patterns" before changing these.
# Runs as a second, independent pattern in the same services/bettor
# process as Pattern 1 -- no separate service to start.
PATTERN2_HIGH_THRESHOLD=8
PATTERN2_STREAK_LENGTH=3
PATTERN2_BET_LINE=7.5
PATTERN2_BET_STAKE_AMOUNT=90
# Kill switch for Pattern 2 only -- Pattern 1 is unaffected either way.
# Defaults to true (unchanged behavior) if unset. Set to false to pause
# Pattern 2: it keeps tracking streaks and logging/publishing
# PatternProgress as normal (so nothing needs to "warm back up"), but never
# arms a target or calls BetExecutor, so it cannot place a bet while off.
PATTERN2_ENABLED=true
