.venv/
__pycache__/
*.pyc
.env
logs/*.log
logs/*.out
data/*.jsonl
# data/result.log and data/bets.log are deliberately NOT ignored — they're
# the human-readable round-by-round history and betting audit trail the
# user tracks for prediction/feature analysis, so they belong in version
# control. Only other *.log files under data/ (if any ever show up) stay
# ignored.
data/*.log
!data/result.log
!data/bets.log
run/
# Throwaway exploration/recon scripts (live-API probing, DOM discovery) --
# never meant to be committed, per the plan's own convention for this dir.
scratch/
